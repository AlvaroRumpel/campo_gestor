{
  // Copy this file to .vscode/launch.json and replace placeholder values.
  // .vscode/launch.json is gitignored — never commit real keys.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Edge, dev)",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      "args": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=PASTE_LOCAL_ANON_KEY_HERE"
      ]
    },
    {
      // Não é para F5 — é a fonte de variáveis do `dart run tool/deploy.dart`.
      "name": "Flutter (Web, prod)",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      "args": [
        "--dart-define=SUPABASE_URL=https://PROJECT_REF.supabase.co",
        "--dart-define=SUPABASE_ANON_KEY=PASTE_CLOUD_PUBLISHABLE_KEY_HERE",
        "--dart-define=APP_ORIGIN=https://campo-gestor.pages.dev"
      ]
    },
    {
      "name": "Flutter (Edge, profile)",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      "flutterMode": "profile",
      "args": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=PASTE_LOCAL_ANON_KEY_HERE"
      ]
    }
  ]
}
